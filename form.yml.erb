---
<%
# Show only CPU partitions.
@partition_filter = :cpu

# Evaluate the shared resource_discovery.erb and capture its result. We use result(binding)
# so methods/variables defined inside become available here. IMPORTANT:
# cluster: "pax" must appear AFTER this block because result(binding)
# resets the ERB output buffer, wiping anything output before it.
_partial_path = '/var/www/ood/apps/sys/ood-resource-discovery/resource_discovery.erb'
_gpu_result = ERB.new(File.read(_partial_path)).result(binding)
%>

cluster: "pax"

bc_dynamic_js: true

form:
  - partition
  - bc_num_hours
  - num_cores
  - num_memory
  - version
  - bc_email_on_started
  - ta_qos

attributes:
  ta_qos:
    widget: check_box
    label: "Request priority start"
    cacheable: false
    help: "Limited to 1 running job at a time. (--qos=interactive)"
    value: "normal"
    checked_value: "interactive"
    unchecked_value: "normal"
<%= generate_partition_field.indent(2) %>
<%= generate_num_cores_field.indent(2) %>
<%= generate_num_memory_field.indent(2) %>
<%= generate_num_hours_field.indent(2) %>

  version:
    widget: "select"
    label: "R version"
    help: "Select the R version."
    options:
      - ["4.6.0", "r/4.6.0"]
      - ["4.5.2", "r/4.5.2"]
      - ["4.5.1", "r/4.5.1"]
