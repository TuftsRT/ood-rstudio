---
cluster: "pax"
form:
  - bc_num_hours
  - num_cores
  - num_memory
  - partition
  - version

attributes:
  num_cores:
    widget: "select"
    label: "Number of CPU Cores"
    options:
      - ["2", "2"]
      - ["4", "4"]
      - ["6", "6"]
      - ["8", "8"]
      - ["12", "12"]
      - ["16", "16"]
      - ["24", "24"]
    help: "Select the number of CPU cores for your job."

  num_memory:
    widget: "number_field"
    label: "Amount of Memory (GB)"
    help: "Enter the memory amount in GB (e.g., `12` for 12GB or `100` for 100GB)."
    required: true
    pattern: "^[0-9]{1,4}$"
    value: 4
    min: 1
    max: 1400

  partition:
    widget: "select"
    label: "Partition"
    help: |
      Selecting a partition is optional.  
      Avoid choosing lab-specific partitions unless you are a member of that lab.
    value: "batch"
    options:
      - ["batch", "Batch (default)"]
      - ["largemem", "Large Memory"]
      - ["preempt", "Preempt (low priority)"]
      - ["patralab", "Patra Lab"]
      - ["llab", "L Lab"]

  version:
    widget: "select"
    label: "R Version"
    help: "Select the desired R version."
    options:
      - ["4.5.1", "r/4.5.1"]        
