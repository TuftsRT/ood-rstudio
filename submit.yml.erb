---
batch_connect:
  template: "basic"
  set_host: "host=$(hostname -A | awk '{print $1}')"
  conn_params:
    - csrf_token
    
script:
  email_on_started: true
  email_on_terminated: true
  email: <%= ENV["USER"] %>@tufts.edu
  job_name: "OnDemand/Rstudio"

  native:
    - "--time=<%= bc_num_hours %>:00:00"
    - "--mem=<%= num_memory %>G"
    - "--nodes=1"
    - "--ntasks=<%= num_cores %>"
    - "--partition=<%= partition %>"