---
batch_connect:
  template: "basic"
  set_host: "host=$(hostname -s)"
  conn_params:
    - csrf_token
    
script:
  email: <%= ENV["USER"] %>@tufts.edu
  job_name: "OnDemand/Rstudio"

  native:
    - "--time=<%= bc_num_hours %>:00:00"
    - "--cpus-per-task=<%= num_cores %>"
    - "--mem=<%= num_memory %>G"
    - "--nodes=1"
    - "--partition=<%= partition %>"
    <%- if defined?(ta_qos) && ta_qos == "interactive" -%>
    - "--qos=<%= ta_qos %>"
    <%- end -%>